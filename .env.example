# General Application Configuration
PROJECT_NAME="RestoOps Catering Revenue Agent"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="restoops_user"
POSTGRES_PASSWORD="restoops_password_dev_123"
POSTGRES_DB="restoops_db"
DATABASE_URL="postgresql+asyncpg://restoops_user:restoops_password_dev_123@localhost:5432/restoops_db"

# Redis & Celery Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Auth / Security
SECRET_KEY="restoops-dev-secret-key-change-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local Email Testing (Mailpit)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@restoops.local"
EMAILS_FROM_NAME="RestoOps System"

# Ollama AI Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Twilio Configuration (Optional / Phase 7)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
